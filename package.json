{
  "name": "shenodev-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "ShenoDev Ecosystem — ShenoStore, ShenoInventory, ShenoFlow",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
